# Copy to .env for local development. Never commit the real .env file.

# Optional. Live answers in Ask AquaAI. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local development works with none of the settings below. Without Firebase
# configured, AquaAI uses local accounts and a local SQLite file.

# Firebase Authentication and Firestore. See docs/DEPLOY.md for where to find each value.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
# Service account for the backend: a file path for local use, or the whole JSON for hosts.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Only used by local accounts, in development.
SECRET_KEY=

# development or production. Production refuses to start with an unsafe setup.
APP_ENV=development

# Only needed if the frontend is hosted on a different domain than the backend.
FRONTEND_ORIGIN=

# Use redis://... for rate limits shared across several servers.
PORT=5000
# RATELIMIT_STORAGE_URI=redis://...
